# Build de release para Linux em Ubuntu 22.04 (glibc 2.35): o binário roda em distribuições desta
# idade ou mais novas. Saída: AppImage do app e tar.gz do CLI e do nó headless, com .sha256.
#
# Use o script `scripts/package/build-linux-release.sh` (docker build + docker cp; sem BuildKit).
FROM ubuntu:22.04 AS build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git unzip xz-utils zip file build-essential clang cmake ninja-build \
      pkg-config libgtk-3-dev libx11-dev libxi-dev libdbus-1-dev libpulse-dev liblzma-dev \
      libstdc++-12-dev \
 && rm -rf /var/lib/apt/lists/*

# Rust (canal e componentes de rust-toolchain.toml).
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:/opt/flutter/bin:$PATH
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable

# Flutter fixado (o app exige 3.47; o `tray_manager` 0.8 precisa dele).
ARG FLUTTER_VERSION=3.47.7
RUN git clone --depth 1 -b ${FLUTTER_VERSION} https://github.com/flutter/flutter.git /opt/flutter \
 && git config --global --add safe.directory '*' \
 && flutter config --no-analytics --no-cli-animations >/dev/null \
 && flutter precache --linux

# Limita a paralelização para não esgotar a RAM em máquinas modestas.
ARG CARGO_BUILD_JOBS=4
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}

COPY . /src
WORKDIR /src/app
RUN flutter pub get && flutter build linux --release
WORKDIR /src
RUN scripts/package/appimage.sh --out /out
RUN scripts/package/tarball.sh --out /out
