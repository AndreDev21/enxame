# Nome DNS público do relay (registro A/AAAA apontando para este servidor; portas 80, 443/tcp e
# 7842/udp liberadas). Também é a URL do relay que o nó e os clientes usam.
RELAY_HOSTNAME=relay.example.org

# LetsEncrypt (padrão) exige ACME_EMAIL. Use ACME_PROD=false para testar com o staging.
RELAY_CERT_MODE=LetsEncrypt
ACME_EMAIL=voce@example.org
ACME_PROD=true

# Nome exibido nos tickets do nó.
NODE_NAME=enxame-node

# Fingerprints (hex, de `enxame-cli id`) que podem virar contato do nó. Vazio = ninguém.
ALLOWED_FINGERPRINTS=

# Budget de contribuição do nó.
MAX_CONTRIB_GB_MONTH=500
#MAX_CONTRIB_KBPS=20000
CARRY_QUOTA_MB_TOTAL=2000
